<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- TASK-101 : même sélection de version que SageTaxReader.Core (doit être passée identique
         aux deux projets, ex. -p:SageInteropVersion=v7, pour rester cohérente). -->
    <SageInteropVersion Condition="'$(SageInteropVersion)'==''">v12</SageInteropVersion>
    <AssemblyName Condition="'$(SageInteropVersion)'=='v12'">SageTaxReader.Console</AssemblyName>
    <AssemblyName Condition="'$(SageInteropVersion)'!='v12'">SageTaxReader.Console.$(SageInteropVersion)</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SageTaxReader.Core\SageTaxReader.Core.csproj" />
    <ProjectReference Include="..\SageTaxReader.Contracts\SageTaxReader.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.0" />
    <PackageReference Include="System.Text.Json" Version="8.0.0" />
  </ItemGroup>

</Project>
