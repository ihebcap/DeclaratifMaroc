<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Fichier de connexion unique et partagé (racine GRF), copié à côté de l'exe -->
    <None Include="..\connections.json" Link="connections.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.29" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.29" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.9" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <!-- TASK-117 : verification de licence ApLicence (lecture seule, repo separe D:\_vibe\GRLicence) -->
    <PackageReference Include="GRLicence" Version="1.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Declaration.Infrastructure\Declaration.Infrastructure.csproj" />
    <ProjectReference Include="..\Declaration.Application\Declaration.Application.csproj" />
  </ItemGroup>

  <!-- TASK-117 : GRLicence.1.1.0 (nuget-local) ne packe pas les DLL ApLicence.* qu'il referencait en
       prive (bug de packaging du repo separe D:\_vibe\GRLicence, son .nupkg ne contient que
       GRLicence.dll). Sans ces references, le chargement d'assembly echoue au runtime avec une
       FileNotFoundException qui echappe meme au try/catch interne de LicenceMonitor (le type Licence
       ne peut pas etre resolu pour JITter la methode). Copies identiques a celles utilisees par
       GRLicence lui-meme (D:\_vibe\GRLicence\libs\ApLicence), memes versions garanties. -->
  <ItemGroup>
    <Reference Include="ApLicence.Common">
      <HintPath>libs\ApLicence\ApLicence.Common.dll</HintPath>
    </Reference>
    <Reference Include="ApLicence.Core">
      <HintPath>libs\ApLicence\ApLicence.Core.dll</HintPath>
    </Reference>
    <Reference Include="ApLicence.Core.Net">
      <HintPath>libs\ApLicence\ApLicence.Core.Net.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
