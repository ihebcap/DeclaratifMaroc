<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Fichier de connexion unique et partagé (racine GRF), copié à côté de l'exe -->
    <None Include="..\connections.json" Link="connections.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.9" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <!-- TASK-074 : requis par Tresorerie.Dapper.dll (BaseRepository/UtilisateurRepository) -->
    <PackageReference Include="System.Data.SqlClient" Version="4.9.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Declaration.Infrastructure\Declaration.Infrastructure.csproj" />
    <ProjectReference Include="..\Declaration.Application\Declaration.Application.csproj" />
  </ItemGroup>

  <!-- TASK-074 : authentification réelle contre P_UTILISATEUR — réutilise le hashage/repo legacy
       déjà validé dans GRC_WEB plutôt que de le réécrire (Tresorerie.Core/.Dapper/.Infrastructure).
       Jeu volontairement minimal (4 DLL) : le reste de l'arbre Trésorerie (Sage/DevExpress/Ninject)
       n'est pas nécessaire pour la seule authentification et ne doit pas coupler Declaration à GRC_WEB. -->
  <ItemGroup>
    <Reference Include="Tresorerie.Core">
      <HintPath>libs\Tresorerie\Tresorerie.Core.dll</HintPath>
    </Reference>
    <Reference Include="Tresorerie.Dapper">
      <HintPath>libs\Tresorerie\Tresorerie.Dapper.dll</HintPath>
    </Reference>
    <Reference Include="Tresorerie.Infrastructure">
      <HintPath>libs\Tresorerie\Tresorerie.Infrastructure.dll</HintPath>
    </Reference>
    <Reference Include="DapperExtensions">
      <HintPath>libs\Tresorerie\DapperExtensions.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
